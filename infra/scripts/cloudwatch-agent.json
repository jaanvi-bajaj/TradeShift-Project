{
  "agent": { "run_as_user": "root" },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/tradeshift/app.log", "log_group_name": "__LOG_GROUP__", "log_stream_name": "{instance_id}/app" },
          { "file_path": "/var/log/tradeshift/access.log", "log_group_name": "__LOG_GROUP__", "log_stream_name": "{instance_id}/access" },
          { "file_path": "/var/log/tradeshift/pipeline.log", "log_group_name": "__LOG_GROUP__", "log_stream_name": "{instance_id}/pipeline" },
          { "file_path": "/var/log/tradeshift-bootstrap.log", "log_group_name": "__LOG_GROUP__", "log_stream_name": "{instance_id}/bootstrap" }
        ]
      }
    }
  }
}
