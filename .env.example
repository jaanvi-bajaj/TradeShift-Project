# Copy to .env for local development. Variable names only: never put real values in Git.
# On EC2, CloudFormation writes these to /etc/tradeshift.env.

# Data source keys (free). Only needed to download data (full pipeline mode).
CENSUS_API_KEY=
COMTRADE_API_KEY=

# Storage: "local" writes under LOCAL_DATA_DIR; "s3" uses S3_BUCKET.
STORAGE_MODE=local
S3_BUCKET=
LOCAL_DATA_DIR=
WORK_DIR=
AWS_REGION=us-east-1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradeshift
DB_USER=tradeshift
DB_PASSWORD=

# Snapshot to restore in snapshot mode (a GitHub release asset URL) and its SHA-256
SNAPSHOT_URL=
SNAPSHOT_SHA256=

# Optional overrides for the detector (defaults in config/settings.py)
# MIN_DROP_PP=5
# MIN_GAIN_PP=3
# MIN_ANNUAL_VALUE_USD=10000000
# WINDOW_MONTHS=12
# LAG_MONTHS=2
# TOP_SUPPLIERS=15
# SECOND_IMPORTER=JP
